{
  "name": "@jotacular/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "echo ok",
    "typecheck": "tsc --noEmit",
    "smoke:worker": "dotenv -e ../../.env -- tsx scripts/smoke-worker.ts",
    "smoke:recognize": "dotenv -e ../../.env -- tsx scripts/smoke-recognize.ts",
    "smoke:structure": "dotenv -e ../../.env -- tsx scripts/smoke-structure.ts",
    "smoke:media": "dotenv -e ../../.env -- tsx scripts/smoke-media.ts",
    "smoke:metering": "dotenv -e ../../.env -- tsx scripts/smoke-metering.ts",
    "reread": "dotenv -e ../../.env -- tsx scripts/reread.ts",
    "smoke:reread": "dotenv -e ../../.env -- tsx scripts/smoke-reread.ts",
    "smoke:triage": "dotenv -e ../../.env -- tsx scripts/smoke-triage.ts",
    "smoke:park": "tsx scripts/smoke-park.ts",
    "smoke:partial": "dotenv -e ../../.env -- tsx scripts/smoke-partial.ts"
  },
  "dependencies": {
    "@jotacular/domain": "workspace:*",
    "@jotacular/embeddings": "workspace:*",
    "@jotacular/db": "workspace:*",
    "tsx": "^4.19.2",
    "@jotacular/vision": "workspace:*",
    "@jotacular/ink-render": "workspace:*",
    "sharp": "^0.33.5",
    "@jotacular/storage": "workspace:*",
    "fastify": "^5.2.1",
    "@jotacular/speech": "workspace:*",
    "@jotacular/reason": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
