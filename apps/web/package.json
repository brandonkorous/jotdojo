{
  "name": "@jotacular/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p 3400",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start -p 3400",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "smoke:oauth-http": "dotenv -e ../../.env -- tsx scripts/smoke-oauth-http.ts",
    "build:verify": "dotenv -e ../../.env -v NEXT_DIST_DIR=.next-verify -- next build",
    "smoke:lasso": "tsx scripts/smoke-lasso.ts",
    "smoke:objects": "tsx scripts/smoke-objects.ts",
    "smoke:shapes": "tsx scripts/smoke-shapes.ts",
    "smoke:pen-size": "tsx scripts/smoke-pen-size.ts",
    "smoke:site": "dotenv -e ../../.env -- tsx scripts/smoke-site.ts",
    "smoke:marks": "tsx scripts/smoke-marks.ts",
    "smoke:billing-http": "dotenv -e ../../.env -- tsx scripts/smoke-billing-http.ts",
    "smoke:viewport": "tsx scripts/smoke-viewport.ts",
    "smoke:gestures": "tsx scripts/smoke-gestures.ts",
    "smoke:merge": "tsx scripts/smoke-merge.ts",
    "smoke:live-http": "dotenv -e ../../.env -- tsx scripts/smoke-live-http.ts",
    "smoke:export": "dotenv -e ../../.env -- tsx scripts/smoke-export.ts",
    "smoke:images": "tsx scripts/smoke-images.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@awesome.me/kit-2fb7fafdba": "^1.0.2",
    "@jotacular/billing": "workspace:*",
    "@jotacular/domain": "workspace:*",
    "@jotacular/ink-render": "workspace:*",
    "@wizeworks/silicaui-react": "^0.55.0",
    "marked": "^15.0.12",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@wizeworks/silicaui": "^0.55.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
