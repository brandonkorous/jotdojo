{
  "name": "@jotacular/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -v NODE_ENV=development -- tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "echo ok",
    "typecheck": "tsc --noEmit",
    "smoke:capture": "dotenv -e ../../.env -- tsx scripts/smoke-capture.ts",
    "smoke:share": "dotenv -e ../../.env -- tsx scripts/smoke-share.ts"
  },
  "dependencies": {
    "@jotacular/domain": "workspace:*",
    "@jotacular/storage": "workspace:*",
    "@wizeworks/lens-node": "0.3.0-alpha.9",
    "fastify": "^5.2.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
