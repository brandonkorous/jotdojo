{
  "name": "@jotacular/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "dotenv -e ../../.env -- tsx scripts/migrate.ts",
    "studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "dev-role": "dotenv -e ../../.env -- tsx scripts/dev-role.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5"
  }
}
