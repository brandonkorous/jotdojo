# --- database -----------------------------------------------------------
# Local dev runs on 5433 to avoid clashing with any host Postgres.
#
# The application connects as the RESTRICTED jotdojo_app role, NEVER as
# postgres. PostgreSQL exempts superusers from every RLS policy, so connecting
# as postgres silently disables the entire tenancy boundary while every policy
# still reads as though it were enforced. See migrations/0001_app_role.sql.
DATABASE_URL=postgresql://jotdojo_app:jotdojo@localhost:5433/jotdojo

# Owner connection. Used only for migrations (DDL) and never by the app.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5433/jotdojo

# --- auth ---------------------------------------------------------------
# openssl rand -base64 32   (or: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Authorized redirect URI: http://localhost:3400/api/auth/callback/google
# Local-only sign-in without Google, so the app is usable before OAuth is set
# up. Set to "true" to enable. In production it is IGNORED and logged as an
# error rather than honoured -- so a stray "true" in a prod environment cannot
# open a passwordless door, but it also will not stop the deploy. Remove it once
# Google OAuth works.
ALLOW_DEV_LOGIN=false

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- app ----------------------------------------------------------------
# AUTH_URL, not NEXTAUTH_URL. Auth.js v5 reads the v4 name for the origin but
# NOT for host trust, so the old name works in dev and rejects every login the
# moment NODE_ENV=production.
AUTH_URL=http://localhost:3400

# The apex, where the marketing site is served from. ADR-040: one deployment
# serves both, chosen by Host. Browsers resolve *.localhost to loopback, so this
# gives a real second hostname locally without touching the hosts file.
SITE_URL=http://jotdojo.localhost:3400

# --- ports (jotdojo owns 3400-3409, see README) -------------------------
# The app, used to build the note URL the Shortcut deep-links to.
APP_URL=http://localhost:3400
API_PORT=3401
# Shown in the Shortcut setup instructions.
API_URL=http://localhost:3401
MCP_PORT=3402

# The canonical resource identifier for the MCP server (RFC 8707). Tokens are
# bound to this exact string, which is what stops a jotdojo token working at
# kanninja. Must match what apps/mcp advertises.
MCP_RESOURCE=http://localhost:3402/mcp

# --- embeddings (semantic search) ----------------------------------------
# Unset means semantic search is off. Lexical and fuzzy search still work, and
# capture is unaffected -- see ADR-007. The worker exits cleanly when unset.
#
#   fake    deterministic hash projection for tests. No network, no key, NO
#           SEMANTICS. Refused outright when NODE_ENV=production.
#   openai  OPENAI_API_KEY (optionally OPENAI_BASE_URL, EMBEDDING_MODEL)
#   azure   AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY,
#           AZURE_OPENAI_EMBEDDING_DEPLOYMENT
EMBEDDING_PROVIDER=fake
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- vision (handwriting recognition) -------------------------------------
# Unset means ink still captures, stores and renders -- only the transcript is
# missing, and the block stays 'pending' until a provider exists. Because the
# STROKES are kept rather than a raster, every page ever drawn becomes readable
# the moment one is configured. docs/08-ink.md.
#
#   fake       returns VISION_FAKE_TEXT. No network. Refused in production.
#   anthropic  ANTHROPIC_API_KEY (VISION_MODEL, default claude-sonnet-5)
#   azure      AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY,
#              AZURE_OPENAI_VISION_DEPLOYMENT
#   openai     OPENAI_API_KEY (VISION_MODEL, default gpt-4o)
VISION_PROVIDER=fake
VISION_FAKE_TEXT=check with Dana about the margins
# ANTHROPIC_API_KEY=
# VISION_MODEL=claude-sonnet-5
# AZURE_OPENAI_VISION_DEPLOYMENT=

# --- raw artifact storage (photos, audio) ---------------------------------
# Ink strokes live in Postgres. Photos and audio do not.
#
#   local  filesystem under STORAGE_LOCAL_ROOT, served by the API with signed
#          URLs. Proxies bytes through the API, so it REFUSES to start when
#          NODE_ENV=production. Development only.
#   azure  browser PUTs straight to Blob with a SAS URL; our servers never see
#          the bytes. Needs AZURE_STORAGE_ACCOUNT, _CONTAINER and _KEY.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.media
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=media
# AZURE_STORAGE_KEY=

# --- speech (voice notes) -------------------------------------------------
# Unset means audio still records, uploads and is kept -- only the transcript
# is missing. The ORIGINAL is retained indefinitely (docs/04), so every
# recording ever made becomes searchable the day a provider is configured.
#
#   fake    returns SPEECH_FAKE_TEXT. No network. Refused in production.
#   openai  OPENAI_API_KEY (SPEECH_MODEL, default whisper-1)
#   azure   AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY,
#           AZURE_OPENAI_SPEECH_DEPLOYMENT
SPEECH_PROVIDER=fake
SPEECH_FAKE_TEXT=remember to call the landlord about the lease
# SPEECH_MODEL=whisper-1
# AZURE_OPENAI_SPEECH_DEPLOYMENT=

# --- billing (ADR-038) ------------------------------------------------------
# Unset means BILLING IS OFF: everyone is on the free plan and nothing pretends
# a payment happened. That is the honest state for a deployment nobody has
# approved spend for.
#
# `fake` takes no money but enforces the SAME webhook signature contract as
# Stripe, so the suites cannot pass against a driver that skips it. It refuses
# to resolve when NODE_ENV=production.
BILLING_PROVIDER=fake
BILLING_WEBHOOK_SECRET=dev-billing-secret

# Only for BILLING_PROVIDER=stripe. Price ids differ per environment, which is
# why they are configuration rather than constants.
#
# USE A RESTRICTED KEY (rk_), not a secret key (sk_). This integration calls
# exactly two endpoints, so the key it needs is tiny: WRITE on Checkout
# Sessions and WRITE on Billing Portal Sessions, and nothing else. The webhook
# never calls the API at all. A restricted key that leaks cannot read your
# customers, refund a charge, or move money.
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_FAMILY=price_...
# STRIPE_PRICE_TEAM=price_...

# --- triage (the agent that reads new notes) --------------------------------
# The only thing in jotdojo that speaks first, so it is the only seam that is
# OFF here by default. Unset means the triage agent never runs, for anybody.
#
# Even with a provider set it is off per space until an owner turns it on, and
# it is part of the Team plan (docs/01). Switching it off stops work already in
# the queue, not just future work.
#
#   fake       returns TRIAGE_FAKE_COMMENT for notes that look like errands.
#              No network. Refused in production.
#   anthropic  ANTHROPIC_API_KEY (TRIAGE_MODEL, default claude-sonnet-5)
#   azure      AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY,
#              AZURE_OPENAI_TRIAGE_DEPLOYMENT
#   openai     OPENAI_API_KEY (TRIAGE_MODEL, default gpt-4o-mini)
# TRIAGE_PROVIDER=fake
# TRIAGE_MODEL=claude-sonnet-5

# How long a note must sit untouched before it is read. This is the difference
# between an assistant and an interruption; do not set it to zero outside a test.
# TRIAGE_QUIET=15 minutes
# How far back a space looks the first time it is switched on.
# TRIAGE_LOOKBACK=24 hours
# How often the worker looks for notes that have settled.
# TRIAGE_EVERY_MS=300000
